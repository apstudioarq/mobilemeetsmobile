{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "test": {
      "conferences": {
        ".read": "auth != null",
        "$conferenceId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['id', 'title', 'audience', 'eventType', 'organizingCountry', 'rooms', 'startDate'])",
          "id": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
          },
          "audience": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "eventType": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "organizingCountry": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "startDate": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "rooms": {
            "$roomIndex": {
              ".validate": "newData.hasChildren(['id', 'name'])",
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
              },
              "description": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              },
              "presentations": {
                "$presentationIndex": {
                  ".validate": "newData.hasChildren(['id', 'title', 'durationMinutes', 'startDate', 'technology', 'type'])",
                  "id": {
                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                  },
                  "title": {
                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
                  },
                  "description": {
                    ".validate": "newData.isString() && newData.val().length <= 4000"
                  },
                  "durationMinutes": {
                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
                  },
                  "presenters": {
                    "$presenterIndex": {
                      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                    }
                  },
                  "startDate": {
                    ".validate": "newData.isNumber() && newData.val() >= 0"
                  },
                  "tags": {
                    "$tagIndex": {
                      ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
                    }
                  },
                  "technology": {
                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                  },
                  "type": {
                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "ratings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$ratingId": {
        ".write": "(auth != null && auth.provider == 'anonymous' && !data.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['audience', 'country', 'date', 'event', 'name', 'rating', 'sessionId', 'sessionTitle', 'comment'])",
        "audience": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "event": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "sessionId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
        },
        "sessionTitle": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
        },
        "comment": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
