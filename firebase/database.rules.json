{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "test": {
      "config": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "appLocked": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      },
      "home": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      },
      "map": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "!newData.exists() || (newData.hasChildren(['imageBase64', 'imageMimeType']) && newData.child('imageBase64').isString() && newData.child('imageBase64').val().length > 0 && newData.child('imageMimeType').isString() && newData.child('imageMimeType').val().matches(/^image\\//))"
      },
      "conferences": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },

    "ratings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$ratingId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && auth.provider == 'anonymous'))",
        ".validate": "newData.hasChildren(['rating', 'sessionId', 'sessionTitle']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('sessionId').isString() && newData.child('sessionId').val().length > 0 && newData.child('sessionTitle').isString() && newData.child('sessionTitle').val().length > 0"
      }
    }
  }
}
