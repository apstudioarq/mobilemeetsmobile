-- Session table for offline caching
CREATE TABLE SessionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    startTime TEXT NOT NULL,
    endTime TEXT NOT NULL,
    duration TEXT NOT NULL,
    room TEXT NOT NULL,
    day INTEGER NOT NULL,
    track TEXT NOT NULL,
    type TEXT NOT NULL,
    level TEXT NOT NULL,
    speakerIds TEXT NOT NULL,  -- JSON array serialized
    capacity INTEGER NOT NULL DEFAULT 0,
    registered INTEGER NOT NULL DEFAULT 0,
    tags TEXT NOT NULL DEFAULT "[]",
    livestreamUrl TEXT,
    slidesUrl TEXT,
    updatedAt INTEGER NOT NULL DEFAULT 0
);

-- Speaker table
CREATE TABLE SpeakerEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    role TEXT NOT NULL,
    company TEXT NOT NULL,
    bio TEXT NOT NULL,
    photoUrl TEXT NOT NULL,
    socialLinks TEXT NOT NULL DEFAULT "{}"
);

-- Bookmarks (local-first)
CREATE TABLE BookmarkEntity (
    sessionId TEXT NOT NULL PRIMARY KEY,
    createdAt INTEGER NOT NULL DEFAULT 0
);

-- Firebase anonymous authentication session
CREATE TABLE FirebaseAuthSessionEntity (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    idToken TEXT NOT NULL,
    refreshToken TEXT NOT NULL,
    expiresAt INTEGER NOT NULL
);

-- Home content configured from Firebase Realtime Database
CREATE TABLE HomeContentEntity (
    singletonId INTEGER NOT NULL PRIMARY KEY CHECK (singletonId = 1),
    welcomeMessage TEXT NOT NULL,
    heroImageUrl TEXT NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0
);

-- Queries

-- Sessions
getAllSessions:
SELECT * FROM SessionEntity ORDER BY day, startTime;

getSessionsByDay:
SELECT * FROM SessionEntity WHERE day = ? ORDER BY startTime;

getSessionsByDayAndTrack:
SELECT * FROM SessionEntity WHERE day = ? AND track = ? ORDER BY startTime;

getSessionById:
SELECT * FROM SessionEntity WHERE id = ?;

searchSessions:
SELECT * FROM SessionEntity
WHERE title LIKE '%' || ? || '%'
   OR description LIKE '%' || ? || '%'
ORDER BY day, startTime;

insertSession:
INSERT OR REPLACE INTO SessionEntity(
    id, title, description, startTime, endTime, duration,
    room, day, track, type, level, speakerIds,
    capacity, registered, tags, livestreamUrl, slidesUrl, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllSessions:
DELETE FROM SessionEntity;

-- Speakers
getAllSpeakers:
SELECT * FROM SpeakerEntity ORDER BY name;

getSpeakerById:
SELECT * FROM SpeakerEntity WHERE id = ?;

getSpeakersByIds:
SELECT * FROM SpeakerEntity WHERE id IN ?;

insertSpeaker:
INSERT OR REPLACE INTO SpeakerEntity(id, name, role, company, bio, photoUrl, socialLinks)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAllSpeakers:
DELETE FROM SpeakerEntity;

-- Bookmarks
getAllBookmarks:
SELECT sessionId FROM BookmarkEntity;

isBookmarked:
SELECT COUNT(*) FROM BookmarkEntity WHERE sessionId = ?;

insertBookmark:
INSERT OR REPLACE INTO BookmarkEntity(sessionId, createdAt) VALUES (?, ?);

deleteBookmark:
DELETE FROM BookmarkEntity WHERE sessionId = ?;

deleteAllBookmarks:
DELETE FROM BookmarkEntity;

-- Firebase authentication
getFirebaseAuthSession:
SELECT idToken, refreshToken, expiresAt
FROM FirebaseAuthSessionEntity
WHERE singletonId = 1;

saveFirebaseAuthSession:
INSERT OR REPLACE INTO FirebaseAuthSessionEntity(
    singletonId, idToken, refreshToken, expiresAt
) VALUES (1, ?, ?, ?);

deleteFirebaseAuthSession:
DELETE FROM FirebaseAuthSessionEntity WHERE singletonId = 1;

-- Home content
getHomeContent:
SELECT welcomeMessage, heroImageUrl
FROM HomeContentEntity
WHERE singletonId = 1;

saveHomeContent:
INSERT OR REPLACE INTO HomeContentEntity(
    singletonId, welcomeMessage, heroImageUrl, updatedAt
) VALUES (1, ?, ?, ?);
